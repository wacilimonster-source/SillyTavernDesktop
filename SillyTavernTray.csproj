<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>SillyTavernTray</AssemblyName>
    <RootNamespace>SillyTavernTray</RootNamespace>
    <Version>1.2.1</Version>
    <ApplicationIcon>assets\tray.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);.tools\**</DefaultItemExcludes>
    <!-- Custom controls are built entirely in code; they never use the WinForms designer. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <None Remove="tests\**\*" />
  </ItemGroup>
</Project>
